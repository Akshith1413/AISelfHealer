NODE_ENV=development
LOG_LEVEL=info

JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key
JWT_ISSUER=neuralmesh-auth
JWT_AUDIENCE=neuralmesh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=neuralmesh
POSTGRES_USER=neuralmesh
POSTGRES_PASSWORD=neuralmesh
DATABASE_URL=postgresql+psycopg://neuralmesh:neuralmesh@postgres:5432/neuralmesh

REDIS_URL=redis://redis:6379/0
KAFKA_BROKERS=kafka:9092

AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
DATA_SERVICE_URL=http://data-service:8001
WORKER_SERVICE_URL=http://worker-service:8002
AI_SERVICE_URL=http://ai-service:8003
METRICS_AGGREGATOR_URL=http://metrics-aggregator:8004
HEALING_ORCHESTRATOR_URL=http://healing-orchestrator:8005
CHAOS_SERVICE_URL=http://chaos-service:8006
NOTIFICATION_SERVICE_URL=http://notification-service:3003
HEALTH_MONITOR_URL=http://health-monitor:8090

GRAFANA_URL=http://grafana:3000
JAEGER_URL=http://jaeger:16686
PROMETHEUS_URL=http://prometheus:9090
MLFLOW_TRACKING_URI=http://mlflow:5000
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=neuralmesh
MINIO_ROOT_PASSWORD=neuralmesh123
VAULT_DEV_ROOT_TOKEN_ID=neuralmesh-root

SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

VITE_GATEWAY_URL=http://localhost:8080
VITE_SOCKET_URL=http://localhost:8080
VITE_GRAFANA_URL=http://localhost:3000

