{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuralmesh.local/contracts/events.schema.json",
  "title": "NeuralMesh Event Envelope",
  "type": "object",
  "required": ["event_id", "event_type", "service_id", "tenant_id", "payload", "timestamp", "correlation_id"],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": {
      "type": "string",
      "enum": [
        "user.auth",
        "service.registered",
        "service.health",
        "service.down",
        "metrics.raw",
        "anomaly.detected",
        "healing.started",
        "healing.complete",
        "healing.failed",
        "scale.event",
        "notification.sent",
        "chaos.started",
        "chaos.completed",
        "root_cause.detected",
        "audit"
      ]
    },
    "service_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "payload": { "type": "object" },
    "timestamp": { "type": "string", "format": "date-time" },
    "causation_id": { "type": ["string", "null"] },
    "correlation_id": { "type": "string" }
  }
}

